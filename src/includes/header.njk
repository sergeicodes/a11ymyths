<header>
  <div class="content">
    <nav class="nav">
      <ul class="nav__list">
        {%- for page in collections.page | sort -%}
          <li class="nav__list-item">
            <a class="nav__link" lang="{{ page.data.lang.code }}" href={% if page.data.lang.code === 'en' %} '/' {% else %} '{{ page.data.lang.code }}/' {% endif %}>
              {{ page.data.lang.title }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  </div>
  <div class="theme-picker">
    <label for="theme-select" class="visually-hidden">Color theme</label>
    <select id="theme-select" class="theme-select">
      <option value="system">{{ lang.theme.system }}</option>
      <option value="light">{{ lang.theme.light }}</option>
      <option value="dark">{{ lang.theme.dark }}</option>
    </select>
  </div>
</header>